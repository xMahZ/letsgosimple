---
import BaseLayout from "../layouts/baselayout.astro";

const updated = new Date().toLocaleDateString("es-CL", {
  timeZone: "America/Santiago",
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
});

const items = [
  {
    n: "01",
    title: "No pedimos datos",
    text: "No hay registro, no hay formularios, no guardamos tu nombre ni RUT. Solo usamos datos técnicos mínimos (IP parcial, navegador) con fines estadísticos.",
  },
  {
    n: "02",
    title: "Cookies",
    text: "Usamos cookies para medir visitas y rendimiento. Puedes desactivarlas desde tu navegador; algunas funciones podrían verse limitadas.",
  },
  {
    n: "03",
    title: "Analítica",
    text: "Medimos qué herramientas se usan más para mejorar el sitio. La información es agregada y no identifica a nadie.",
  },
  {
    n: "04",
    title: "Publicidad",
    text: "En el futuro podríamos incluir anuncios. Si eso ocurre, esta política se actualizará para reflejarlo.",
  },
  {
    n: "05",
    title: "Los datos son referenciales",
    text: "Los valores financieros (UF, USD, UTM…) provienen de fuentes públicas. Son informativos, no constituyen asesoría financiera ni legal.",
  },
  {
    n: "06",
    title: "Cambios",
    text: "Esta política puede cambiar. Siempre verás la fecha de última actualización aquí arriba.",
  },
];
---

<BaseLayout
  title="Privacidad | LetsGoSimple"
  description="Política de privacidad de LetsGoSimple."
>
  <main class="max-w-3xl mx-auto px-6 py-20">
    <!-- Header -->
    <div class="mb-14">
      <p class="text-xs uppercase tracking-widest text-slate-500 mb-4">Legal</p>
      <h1 class="text-4xl font-bold text-slate-50 tracking-tight">
        Privacidad
      </h1>
      <p class="mt-3 text-slate-400">Simple y directo, como todo acá.</p>
      <p class="mt-2 text-xs text-slate-600">Actualizado: {updated}</p>
    </div>

    <!-- Items -->
    <div class="space-y-8">
      {
        items.map((item) => (
          <div class="flex gap-6 group">
            <span class="text-xs font-mono text-slate-700 pt-1 shrink-0 w-6">
              {item.n}
            </span>
            <div class="border-t border-slate-800 pt-4 flex-1">
              <h2 class="text-sm font-semibold text-slate-200 mb-2">
                {item.title}
              </h2>
              <p class="text-sm text-slate-500 leading-relaxed">{item.text}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Contact -->
    <div class="mt-16 border-t border-slate-800 pt-10">
      <p class="text-sm text-slate-500">
        ¿Dudas? Escríbenos a{" "}
        <a
          href="mailto:contacto@letsgosimple.app"
          class="text-slate-300 hover:text-white underline underline-offset-4 transition-colors"
        >
          contacto@letsgosimple.app
        </a>
      </p>
    </div>

    <!-- Back -->
    <div class="mt-10">
      <a
        href="/"
        class="text-xs text-slate-600 hover:text-slate-400 transition-colors"
        >← Volver al inicio</a
      >
    </div>
  </main>
</BaseLayout>
