---
import BaseLayout from "../layouts/baselayout.astro";
---

<BaseLayout
  title="Contacto | LetsGoSimple"
  description="Contacto LetsGoSimple. Envíanos un mensaje o sugiere una herramienta."
>
  <main class="max-w-4xl mx-auto px-6 py-20">
    <!-- Header -->
    <section class="text-center">
      <div
        class="inline-flex items-center px-4 py-2 rounded-full bg-white/5 border border-white/10 text-slate-300 text-sm"
      >
        Contacto
      </div>

      <h1 class="mt-8 text-6xl font-bold tracking-tight text-white">
        Hablemos
      </h1>

      <p class="mt-6 text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        ¿Tienes una sugerencia, encontraste un error o quieres proponer una
        herramienta? Escríbenos y responderemos lo antes posible.
      </p>
    </section>

    <!-- Form -->
    <section class="mt-20 relative">
      <!-- Glow -->
      <div
        class="absolute -inset-6 rounded-[2rem] bg-gradient-to-r from-indigo-500/20 via-purple-500/10 to-sky-500/20 blur-3xl opacity-60"
      >
      </div>

      <div class="relative rounded-[2rem] bg-white/5 p-10 sm:p-12">
        <form
          action="https://formspree.io/f/xrejvapb"
          method="POST"
          class="space-y-10"
        >
          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <label class="block text-sm font-medium text-slate-300 mb-3">
                Nombre
              </label>
              <input
                type="text"
                name="name"
                required
                placeholder="Tu nombre"
                class="w-full rounded-2xl bg-black/20 border border-white/10 px-5 py-4 text-white placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-white/20 transition"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-300 mb-3">
                Correo
              </label>
              <input
                type="email"
                name="email"
                required
                placeholder="tucorreo@email.com"
                class="w-full rounded-2xl bg-black/20 border border-white/10 px-5 py-4 text-white placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-white/20 transition"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-300 mb-3">
              Mensaje
            </label>
            <textarea
              name="message"
              required
              rows="7"
              placeholder="Escribe tu mensaje..."
              class="w-full rounded-2xl bg-black/20 border border-white/10 px-5 py-4 text-white placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-white/20 transition resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-2xl bg-white text-black font-semibold text-lg py-5 hover:opacity-90 transition flex items-center justify-center gap-3"
          >
            Enviar mensaje
            <span class="text-xl">→</span>
          </button>

          <div
            class="flex items-center justify-center gap-3 text-sm text-slate-500"
          >
            <span class="opacity-70">🔒</span>
            <span>
              Este formulario no guarda datos en el sitio. Solo envía el mensaje
              al administrador.
            </span>
          </div>
        </form>
      </div>
    </section>

    <footer
      class="mt-24 pt-10 border-t border-white/10 text-sm text-slate-500 text-center"
    >
      <a
        href="/"
        class="inline-flex items-center gap-2 hover:text-white transition"
      >
        <span class="text-lg">←</span>
        Volver al inicio
      </a>
    </footer>
  </main>
</BaseLayout>
