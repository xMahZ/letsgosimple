---
import BaseLayout from "../layouts/baselayout.astro";
---

<BaseLayout
  title="Contacto | LetsGoSimple"
  description="Contacto LetsGoSimple. Envíanos un mensaje o sugiere una herramienta."
>
  <main class="max-w-3xl mx-auto px-6 py-20">
    <!-- Header -->
    <div class="mb-14">
      <p class="text-xs uppercase tracking-widest text-slate-500 mb-4">
        Contacto
      </p>
      <h1 class="text-4xl font-bold text-slate-50 tracking-tight">Hablemos</h1>
      <p class="mt-3 text-slate-400">
        ¿Sugerencia, error o quieres proponer una herramienta? Escríbenos.
      </p>
    </div>

    <!-- Form -->
    <form
      action="https://formspree.io/f/xrejvapb"
      method="POST"
      class="space-y-8"
    >
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-slate-400 mb-2"
            >Nombre</label
          >
          <input
            type="text"
            name="name"
            required
            placeholder="Tu nombre"
            class="w-full rounded-lg bg-slate-900/60 border border-slate-800 px-4 py-3 text-white placeholder:text-slate-600 focus:outline-none focus:border-slate-600 transition"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-400 mb-2"
            >Correo</label
          >
          <input
            type="email"
            name="email"
            required
            placeholder="tucorreo@email.com"
            class="w-full rounded-lg bg-slate-900/60 border border-slate-800 px-4 py-3 text-white placeholder:text-slate-600 focus:outline-none focus:border-slate-600 transition"
          />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-400 mb-2"
          >Mensaje</label
        >
        <textarea
          name="message"
          required
          rows="6"
          placeholder="Escribe tu mensaje..."
          class="w-full rounded-lg bg-slate-900/60 border border-slate-800 px-4 py-3 text-white placeholder:text-slate-600 focus:outline-none focus:border-slate-600 transition resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full rounded-lg bg-blue-900 hover:bg-orange-400 text-white font-semibold py-3 transition flex items-center justify-center gap-2"
      >
        Enviar mensaje
        <span>→</span>
      </button>

      <p class="text-xs text-slate-600 text-center">
        🔒 Este formulario no guarda datos en el sitio. Solo envía el mensaje al
        administrador.
      </p>
    </form>

    <!-- Back -->
    <div class="mt-16 border-t border-slate-800 pt-10">
      <a
        href="/"
        class="text-xs text-slate-600 hover:text-slate-400 transition-colors"
        >← Volver al inicio</a
      >
    </div>
  </main>
</BaseLayout>
