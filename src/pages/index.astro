---
import BaseLayout from "../layouts/baselayout.astro";
const herramientas = [
  {
    nombre: "UF a Peso",
    descripcion: "Convierte UF a pesos chilenos rápidamente.",
    url: "/cl/fn/uf-a-peso"
  },

  {
    nombre: "Sueldo Líquido",
    descripcion: "Calcula tu sueldo líquido en Chile.",
    url: "/cl/emp/sueldo-liquido"
  },
  {
    nombre: "Porcentaje",
    descripcion: "Calcula porcentajes simples.",
    url: "/cl/util/porcentaje"
  }
];

import data from "../../data/cl-finance.json";
const date = data.updated_at;
const uf = data.rates.uf.value_clp;
const usd = data.rates.usd.value_clp;
const utm = data.rates.utm.value_clp;
---

<BaseLayout
  title="LetsGoSimple"
  description="Herramientas rápidas y simples para Chile."
>
  <main class="max-w-5xl mx-auto px-6 py-16">
    <section class="text-center">
      <h1 class="text-6xl font-bold tracking-tight">
        LetsGoSimple
      </h1>
      <p class="mt-6 text-xl text-gray-600 max-w-2xl mx-auto">
        Herramientas rápidas, simples y útiles.
        Sin distracciones.
      </p>
      <div class="mt-10">
      </div>
    </section>
    <section class="text-center">
  <div class="mt-2 grid gap-5">

    <div class="p-4 rounded-lg border border-white/10 bg-white/5">
      <div class="text-sm text-slate-400">UF</div>
      <div id="uf" class="text-xl text-white">UF: ${uf.toLocaleString("es-CL")}</div>
    </div>

    <div class="p-4 rounded-lg border border-white/10 bg-white/5">
      <div class="text-sm text-slate-400">USD</div>
      <div id="usd" class="text-xl text-white">USD: ${usd.toLocaleString("es-CL")}</div>
    </div>

    <div class="p-4 rounded-lg border border-white/10 bg-white/5">
      <div class="text-sm text-slate-400">UTM</div>
      <div id="utm" class="text-xl text-white">UTM: ${utm.toLocaleString("es-CL")}</div>
    </div>
<div class="p-1 rounded-lg border border-white/10 bg-white/5">
      <div class="text-sm text-slate-300">Cifras actualizadas al:</div>
      <div id="uf" class="text text-white">{date.toLocaleString("es-CL")}</div>
    </div>
  </div>
    </section>
    <section id="herramientas" class="mt-24">
      <h2 class="text-3xl font-bold">
        Herramientas
      </h2>
      <div class="grid md:grid-cols-3 gap-6 mt-10">
        {
          herramientas.map((h) => (
            <a
              href={h.url}
              class="border rounded-2xl p-6 hover:shadow-lg transition"
            >
              <h3 class="text-2xl font-semibold">
                {h.nombre}
              </h3>
              <p class="mt-3 text-gray-600">
                {h.descripcion}
              </p>
            </a>
          ))
        }
      </div>
    </section>
    <footer class="mt-32 pt-10 border-t text-sm text-gray-500">
      © 2026 LetsGoSimple
    </footer>
  </main>
</BaseLayout>

