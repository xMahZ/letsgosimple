dex · ASTRO
Copiar

---
import BaseLayout from "../layouts/baselayout.astro";
 
const tools = [
  {
    category: "Finanzas",
    emoji: "₿",
    items: [
      { name: "UF a CLP", desc: "Valor UF del día en pesos chilenos.", href: "/cl/finanzas/uf-a-clp", badge: "Nuevo" },
      { name: "Dólar a CLP", desc: "Tipo de cambio USD actualizado.", href: "/cl/finanzas/dolar-a-clp", badge: "Nuevo" },
      { name: "UTM a CLP", desc: "Unidad Tributaria Mensual vigente.", href: "/cl/finanzas/utm-a-clp", badge: "Nuevo" },
      { name: "UTA a CLP", desc: "Unidad Tributaria Anual vigente.", href: "/cl/finanzas/uta-a-clp", badge: "Nuevo" },
      { name: "IVA", desc: "Impuesto al Valor Agregado (IVA).", href: "/cl/finanzas/iva", badge: "Nuevo" },
    ],
  },
  {
    category: "Laboral",
    emoji: "📄",
    items: [
    { name: "Sueldo Liquido", desc: "Calcula tu sueldo liquido fácilmente.", href: "/cl/laboral/sueldo-liquido", badge: "Nuevo" },
    { name: "Comparador de AFP", desc: "Veamos cuando pagarías en otra AFP", href: "/cl/laboral/comparador-afp", badge: "Nuevo" },    
    { name: "Calculadora de finiquito", desc: "Calcula tu finiquito en segundos.", href: "/cl/laboral/finiquito", badge: "Pronto" },
    { name: "Carta de renuncia", desc: "Redacta tu carta lista para firmar.", href: "/cl/laboral/carta-renuncia", badge: "Pronto" },
    ],
  },
  {
    category: "Matemáticas",
    emoji: "∑",
    items: [
    { name: "Regla de tres", desc: "Directa e inversa. Tres datos, tú pones los tres, nosotros el cuarto.", href: "/cl/matematicas/regla-de-tres", badge: "Nuevo" },
    { name: "Porcentajes", desc: "Calcula porcentajes, descuentos, aumentos y proporciones al instante.", href: "/cl/matematicas/porcentajes", badge: "Nuevo" },
    { name: "Calculadora de descuentos", desc: "Descubre cuánto pagarás y cuánto ahorrarás al instante.", href: "/cl/matematicas/calculadora-descuentos", badge: "Nuevo" },
    { name: "Generador de notas", desc: "¿Cuánto necesitas en el examen para pasar? En escala del 1 al 7.", href: "/cl/matematicas/generador-de-notas", badge: "Nuevo" },    
    ],
  },
];
---

<BaseLayout title="LetsGoSimple — Herramientas simples y rápidas" description="Herramientas simples y rápidas para el día a día. Sin complicaciones.">
  <main class="relative overflow-hidden">
 
    <!-- Ambient background glow -->
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute top-[-10%] left-[10%] w-[500px] h-[500px] rounded-full bg-blue-600/10 blur-[120px]"></div>
      <div class="absolute top-[20%] right-[-5%] w-[400px] h-[400px] rounded-full bg-indigo-500/8 blur-[100px]"></div>

    </div>
 
  <!-- ═══════════════════════════════ HERO ═══════════════════════════════ -->
    <section class="mx-auto max-w-6xl px-6 pt-24 pb-20 md:pt-16 md:pb-28">
 
      <!-- Headline -->
      <h1 class="animate-fadein fo
      nt-display text-[clamp(2.8rem,8vw,6rem)] font-bold leading-[0.92] tracking-tight text-slate-50 max-w-4xl" style="animation-delay:80ms">
        Lets Go<br/>
        <span class="text-orange-400">
          Simple.
        </span>
      </h1>
 
      <!-- Sub -->
      <p class="animate-fadein mt-7 max-w-xl text-lg text-slate-400 leading-relaxed" style="animation-delay:160ms">
        Hagamos esto simple.
      </p>
 
 
      <!-- CTA -->
      <div class="animate-fadein mt-10 flex flex-wrap gap-3" style="animation-delay:240ms">
        <a href="#herramientas"
           class="group inline-flex items-center gap-2 rounded-lg bg-blue-900 hover:bg-blue-500 px-5 py-2.5 text-sm font-semibold text-white transition-all duration-200 shadow-lg shadow-blue-900/30">
          Ver herramientas
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/contacto"
           class="inline-flex items-center gap-2 rounded-lg border border-slate-700 hover:border-slate-500 bg-slate-800/40 hover:bg-slate-800 px-5 py-2.5 text-sm font-semibold text-slate-300 hover:text-slate-100 transition-all duration-200">
          Sugerir herramienta
        </a>
      </div>
 
    </section>
 
    <!-- ════════════════════════════ TOOLS GRID ════════════════════════════ -->
    <section id="herramientas" class="mx-auto max-w-6xl px-6 pb-28">
 
      <div class="mb-10">
        <h2 class="font-display text-2xl font-bold text-slate-100 tracking-tight">Herramientas disponibles</h2>
        <p class="mt-1 text-sm text-slate-500">Las marcadas como <span class="text-amber-400/80 font-medium">Pronto</span> vienen en camino !</p>
      </div>
 
      <div class="space-y-12">
        {tools.map(group => (
          <div>
            <!-- Category label -->
            <div class="flex items-center gap-3 mb-4">
              <span class="text-xl">{group.emoji}</span>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-slate-500">{group.category}</h3>
              <div class="flex-1 h-px bg-slate-800"></div>
            </div>
 
            <!-- Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {group.items.map(tool => (
                <a
                  href={tool.badge === "Pronto" ? "#" : tool.href}
                  class={`group relative flex flex-col gap-3 rounded-xl border p-5 transition-all duration-200
                    ${tool.badge === "Pronto"
                      ? "border-slate-800 bg-slate-900/30 cursor-default opacity-60"
                      : "border-slate-700/60 bg-slate-900/50 hover:border-blue-500/40 hover:bg-slate-800/60 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-blue-950/40"
                    }`}
                >
                  <div class="flex items-start justify-between">
                    <p class="font-semibold text-slate-100 text-sm leading-tight">{tool.name}</p>
                    <span class={`shrink-0 ml-2 rounded-full px-2 py-0.5 text-[10px] font-semibold tracking-wide
                      ${tool.badge === "Nuevo"
                        ? "bg-emerald-500/15 text-emerald-400 border border-emerald-500/20"
                        : "bg-slate-700/50 text-slate-500 border border-slate-700"
                      }`}>
                      {tool.badge}
                    </span>
                  </div>
                  <p class="text-xs text-slate-500 leading-relaxed">{tool.desc}</p>
                  {tool.badge !== "Pronto" && (
                    <div class="mt-auto pt-1 flex items-center gap-1 text-xs text-blue-400 opacity-0 group-hover:opacity-100 transition-opacity">
                      Ir a la herramienta
                      <svg class="w-3 h-3 translate-x-0 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                    </div>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
 
    <!-- ══════════════════════════════ MANIFESTO ═══════════════════════════ -->
    <section class="border-t border-slate-800/60 bg-slate-900/20">
      <div class="mx-auto max-w-6xl px-6 py-20 grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="font-display text-3xl md:text-4xl font-black text-slate-100 leading-tight tracking-tight">
            ¿Por qué<br/><span class="text-blue-400">LetsGoSimple?</span>
          </h2>
        </div>
        <div class="space-y-5 text-sm text-slate-400 leading-relaxed">
          <p>
            La mayoría de las herramientas online te piden que te registres, te muestran 10 anuncios
            y te hacen hacer 5 clics para obtener un número.
          </p>
          <p>
            Aquí no. Entras, obtienes la respuesta, listo.
            Así de simple, así de rápido.
          </p>
          <p class="text-slate-300 font-medium">
            Sin cuentas. Sin fricciones. Sin excusas.
          </p>
        </div>
      </div>
    </section>
 
  </main>
</BaseLayout>
 
<style>
  
  @keyframes fadein {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }
 
  .animate-fadein {
    opacity: 0;
    animation: fadein 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
</style>