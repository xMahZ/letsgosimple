---
import BaseLayout from "@/layouts/baselayout.astro";
import data from "@/data/cl-finance.json";

// valor UTM real (número)
const utmValue = data.latest?.utm;

// variaciones UTM (objeto con 7d/30d/60d)
const utmVar = data.latest?.variations?.utm;

const updatedAtraw = data.latest?.date;

// Fecha formateada
const [year, month, day] = updatedAtraw.split("-");
const updatedAt = `${day}-${month}-${year}`;

// helper seguro
const getPct = (obj) => (obj && typeof obj.pct === "number" ? obj.pct : null);

// variaciones
const var7 = utmVar?.["7d"];
const var30 = utmVar?.["30d"];
const var60 = utmVar?.["60d"];

// textos UI
const var7Text = (() => {
  const v = getPct(var7);
  return v !== null ? `${v >= 0 ? "+" : ""}${v.toFixed(2)}%` : "N/A";
})();

const var30Text = (() => {
  const v = getPct(var30);
  return v !== null ? `${v >= 0 ? "+" : ""}${v.toFixed(2)}%` : "N/A";
})();

const var60Text = (() => {
  const v = getPct(var60);
  return v !== null ? `${v >= 0 ? "+" : ""}${v.toFixed(2)}%` : "N/A";
})();

// clases UI
const getClass = (obj) => {
  const v = getPct(obj);
  if (v === null) return "text-slate-500";
  return v >= 0 ? "text-green-400" : "text-red-400";
};

const var7Class = getClass(var7);
const var30Class = getClass(var30);
const var60Class = getClass(var60);
---

<BaseLayout title="UTM a CLP | Conversor UTM a Peso Chileno">
  <Fragment slot="head">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Cómo convertir UTM a pesos chilenos?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Para convertir UTM a pesos chilenos se multiplica el monto en UTM por el valor vigente de la UTM publicado oficialmente."
            }
          },
          {
            "@type": "Question",
            "name": "¿Qué es la UTM en Chile?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "La UTM (Unidad Tributaria Mensual) es una unidad de cuenta usada en Chile para multas, impuestos y trámites tributarios. Su valor se reajusta mensualmente."
            }
          },
          {
            "@type": "Question",
            "name": "¿El conversor UTM a CLP es exacto?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "El conversor es aproximado y se basa en el valor oficial de la UTM publicado para el mes vigente."
            }
          }
        ]
      }
    </script>
  </Fragment>

  <main class="max-w-2xl mx-auto px-4 py-12">
    <h1 id="pageTitle" class="text-3xl font-semibold tracking-tight text-white">
      UTM a CLP
    </h1>

    <p id="pageDesc" class="mt-2 text-slate-400">
      Conversor rápido de Unidad Tributaria Mensual a Peso Chileno.
    </p>

    <div class="mt-6 p-6 rounded-xl border border-white/10 bg-white/5">
      <!-- 🔹 UTM actual -->
      <div class="text-sm text-slate-400 mb-4">
        Valor UTM actual:
        <span class="text-blue-400 font-medium">
          $ {utmValue.toLocaleString("es-CL")}
        </span>

        <span class="text-slate-500">
          - Actualizado al {updatedAt}
        </span>

        <span class="text-slate-600"> · Datos oficiales Chile </span>
      </div>

      <!-- 🔹 INPUT HEADER -->
      <div class="flex items-center justify-between mb-2">
        <label id="inputLabel" class="block text-sm text-slate-300">
          Ingresa UTM
        </label>

        <button
          id="swapBtn"
          type="button"
          class="w-20 h-10 flex items-center justify-center rounded-lg border border-white/10 text-slate-300 hover:text-white hover:bg-white/5 transition text-sm"
          title="Invertir conversión"
        >
          <span
            id="swapIcon"
            class="inline-block transition-transform duration-300"
          >
            ⇄
          </span>
        </button>
      </div>

      <!-- 🔹 INPUT -->
      <input
        id="utmInput"
        type="number"
        step="0.01"
        placeholder="Ej: 2.5 UTM"
        class="w-full px-4 py-3 rounded-lg bg-[#070b16] border border-white/10 text-white outline-none focus:border-blue-500"
      />

      <!-- 🔹 RESULTADO -->
      <div
        class="mt-6 p-4 rounded-lg border border-white/10 bg-[#070b16] flex items-center justify-between gap-4"
      >
        <div>
          <div class="text-sm text-slate-400">Resultado</div>
          <div id="result" class="text-2xl text-white mt-1">—</div>
        </div>

        <button
          id="copyBtn"
          class="px-3 py-2 rounded-lg border border-white/10 text-slate-300 hover:text-white hover:bg-white/5 transition text-sm"
        >
          Copiar
        </button>
      </div>

      <!-- 🔹 VARIACIONES -->
      <div class="mt-4 flex items-center gap-3 text-xs text-slate-400">
        <span>Variaciones UTM:</span>

        <span class={var7Class}>
          7 días {var7Text}
        </span>

        <span class="text-slate-600">•</span>

        <span class={var30Class}>
          30 días {var30Text}
        </span>

        <span class="text-slate-600">•</span>

        <span class={var60Class}>
          60 días {var60Text}
        </span>
      </div>
    </div>

    <section class="mt-6">
      <h2 class="text-white font-semibold text-base mb-2">
        Conversiones comunes de UTM a CLP
      </h2>

      <p class="text-slate-500 text-xs mb-4">
        Valores aproximados según la UTM vigente. Haz clic para usar el monto.
      </p>

      <div class="space-y-1">
        {
          [1, 5, 10, 50, 100, 500].map((value) => (
            <button
              class="quick-row w-full flex items-center justify-between px-10 py-2 rounded-lg bg-white/5 hover:bg-white/10 transition text-sm"
              data-value={value}
              type="button"
            >
              <span class="text-slate-200">
                {value.toLocaleString("es-CL")} UTM
              </span>

              <span class="text-slate-400">
                ${" "}
                {(value * utmValue).toLocaleString("es-CL", {
                  minimumFractionDigits: 0,
                  maximumFractionDigits: 0,
                })}
              </span>
            </button>
          ))
        }
      </div>

      <div class="sr-only">
        <p>
          1 UTM a pesos chilenos equivalen aproximadamente a ${
            (1 * utmValue).toLocaleString("es-CL")
          } pesos.
        </p>
        <p>
          5 UTM a pesos chilenos equivalen aproximadamente a ${
            (5 * utmValue).toLocaleString("es-CL")
          } pesos.
        </p>
        <p>
          10 UTM a pesos chilenos equivalen aproximadamente a ${
            (10 * utmValue).toLocaleString("es-CL")
          } pesos.
        </p>
        <p>
          50 UTM a pesos chilenos equivalen aproximadamente a ${
            (50 * utmValue).toLocaleString("es-CL")
          } pesos.
        </p>
        <p>
          100 UTM a pesos chilenos equivalen aproximadamente a ${
            (100 * utmValue).toLocaleString("es-CL")
          } pesos.
        </p>
        <p>
          500 UTM a pesos chilenos equivalen aproximadamente a ${
            (500 * utmValue).toLocaleString("es-CL")
          } pesos.
        </p>
      </div>
    </section>

    <section class="mt-6 text-slate-300 leading-relaxed text-sm">
      <h2 class="text-white font-semibold text-lg mb-4">¿Qué es la UTM?</h2>

      <div class="flex gap-2 mb-4">
        <button
          id="tabShort"
          class="px-3 py-2 rounded-lg border border-white/10 bg-white/10 text-white text-xs font-medium transition"
          type="button"
        >
          En pocas palabras
        </button>

        <button
          id="tabFull"
          class="px-3 py-2 rounded-lg border border-white/10 text-slate-300 text-xs font-medium hover:bg-white/5 transition"
          type="button"
        >
          Explicación completa
        </button>
      </div>

      <!-- Corto -->
      <div id="contentShort">
        <p>
          La UTM (Unidad Tributaria Mensual) es un valor que se usa en Chile
          para calcular multas, impuestos y pagos tributarios. Se actualiza cada
          mes, por lo que su valor en pesos puede variar.
        </p>
      </div>

      <!-- Completo -->
      <div id="contentFull" class="hidden">
        <p>
          La UTM (Unidad Tributaria Mensual) es una unidad de cuenta definida en
          Chile y utilizada principalmente en el sistema tributario. Sirve como
          referencia para calcular multas, impuestos, pagos y sanciones.
        </p>

        <p class="mt-3">
          Su valor se reajusta mensualmente y se expresa en pesos chilenos
          (CLP). Debido a esto, una multa expresada en UTM puede cambiar su
          valor en pesos dependiendo del mes en que se pague.
        </p>

        <p class="mt-3">
          Para convertir UTM a CLP basta multiplicar el monto ingresado por el
          valor vigente de la UTM. Este conversor lo realiza automáticamente.
        </p>
      </div>

      <h2 class="text-white font-semibold text-lg mt-8 mb-2">
        ¿Cómo convertir UTM a CLP?
      </h2>

      <p>
        Para convertir UTM a pesos chilenos, se multiplica el monto en UTM por
        el valor vigente publicado oficialmente. Este conversor lo hace
        automáticamente.
      </p>

      <div class="sr-only">
        <p>
          Conversor de UTM a CLP que permite calcular cualquier monto de Unidad
          Tributaria Mensual a pesos chilenos en segundos.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline define:vars={{ utmValue }}>
  document.addEventListener("DOMContentLoaded", () => {
    const pageTitle = document.getElementById("pageTitle");
    const pageDesc = document.getElementById("pageDesc");
    const input = document.getElementById("utmInput");
    const result = document.getElementById("result");
    const copyBtn = document.getElementById("copyBtn");
    const swapBtn = document.getElementById("swapBtn");
    const swapIcon = document.getElementById("swapIcon");
    const inputLabel = document.getElementById("inputLabel");

    const tabShort = document.getElementById("tabShort");
    const tabFull = document.getElementById("tabFull");
    const contentShort = document.getElementById("contentShort");
    const contentFull = document.getElementById("contentFull");

    let mode = "UTM_TO_CLP"; // UTM_TO_CLP | CLP_TO_UTM

    function formatCLP(value) {
      return (
        "$" +
        value.toLocaleString("es-CL", {
          minimumFractionDigits: 0,
          maximumFractionDigits: 0,
        })
      );
    }

    function formatUTM(value) {
      return (
        value.toLocaleString("es-CL", {
          minimumFractionDigits: 4,
          maximumFractionDigits: 4,
        }) + " UTM"
      );
    }

    function updateUI() {
      if (mode === "UTM_TO_CLP") {
        inputLabel.innerText = "Ingresa UTM";
        input.placeholder = "Ej: 2.5 UTM";

        pageTitle.innerText = "UTM a CLP";
        pageDesc.innerText =
          "Conversor rápido de Unidad Tributaria Mensual a Peso Chileno.";
      } else {
        inputLabel.innerText = "Ingresa CLP";
        input.placeholder = "Ej: 500000";

        pageTitle.innerText = "CLP a UTM";
        pageDesc.innerText =
          "Conversor rápido de Peso Chileno a Unidad Tributaria Mensual.";
      }
    }

    function calc() {
      const raw = input.value.replace(",", ".");
      const amount = Number(raw);

      if (isNaN(amount) || amount <= 0) {
        result.innerText = "—";
        return;
      }

      if (mode === "UTM_TO_CLP") {
        result.innerText = formatCLP(amount * utmValue);
      } else {
        result.innerText = formatUTM(amount / utmValue);
      }
    }

    function activateTab(tab) {
      const isShort = tab === "short";

      contentShort.classList.toggle("hidden", !isShort);
      contentFull.classList.toggle("hidden", isShort);

      tabShort.classList.toggle("bg-white/10", isShort);
      tabShort.classList.toggle("text-white", isShort);
      tabShort.classList.toggle("text-slate-300", !isShort);

      tabFull.classList.toggle("bg-white/10", !isShort);
      tabFull.classList.toggle("text-white", !isShort);
      tabFull.classList.toggle("text-slate-300", isShort);
    }

    tabShort?.addEventListener("click", () => activateTab("short"));
    tabFull?.addEventListener("click", () => activateTab("full"));

    swapBtn?.addEventListener("click", () => {
      swapIcon.style.transform = "rotate(180deg)";
      setTimeout(() => {
        swapIcon.style.transform = "rotate(0deg)";
      }, 300);

      mode = mode === "UTM_TO_CLP" ? "CLP_TO_UTM" : "UTM_TO_CLP";
      updateUI();
      calc();
    });

    input?.addEventListener("input", calc);

    copyBtn?.addEventListener("click", async () => {
      const text = result.innerText;
      if (!text || text === "—") return;

      try {
        await navigator.clipboard.writeText(text);
        copyBtn.innerText = "Copiado ✓";

        setTimeout(() => {
          copyBtn.innerText = "Copiar";
        }, 1200);
      } catch (err) {
        console.error("No se pudo copiar:", err);
      }
    });

    document.addEventListener("click", (e) => {
      const row = e.target.closest(".quick-row");
      if (!row) return;

      const val = row.getAttribute("data-value");
      if (!val) return;

      mode = "UTM_TO_CLP";
      updateUI();

      input.value = val;
      calc();
    });

    updateUI();
    activateTab("short");
  });
</script>
