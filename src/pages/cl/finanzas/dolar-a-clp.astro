---
import BaseLayout from "@/layouts/baselayout.astro";
import data from "@/data/cl-finance.json";

const usdValue = data.latest?.usd;
const usdVar = data.latest?.variations?.usd;

const updatedAtRaw = data.latest?.dates?.usd ?? data.latest?.date;
const [year, month, day] = updatedAtRaw.split("-");
const updatedAt = `${day}-${month}-${year}`;

const getPct = (obj) => (obj && typeof obj.pct === "number" ? obj.pct : null);

const var7 = usdVar?.["7d"];
const var30 = usdVar?.["30d"];
const var60 = usdVar?.["60d"];

const var7Text = (() => {
  const v = getPct(var7);
  return v !== null ? `${v >= 0 ? "+" : ""}${v.toFixed(2)}%` : "N/A";
})();
const var30Text = (() => {
  const v = getPct(var30);
  return v !== null ? `${v >= 0 ? "+" : ""}${v.toFixed(2)}%` : "N/A";
})();
const var60Text = (() => {
  const v = getPct(var60);
  return v !== null ? `${v >= 0 ? "+" : ""}${v.toFixed(2)}%` : "N/A";
})();

const getClass = (obj) => {
  const v = getPct(obj);
  if (v === null) return "text-slate-500";
  return v >= 0 ? "text-green-400" : "text-red-400";
};

const var7Class = getClass(var7);
const var30Class = getClass(var30);
const var60Class = getClass(var60);
---

<BaseLayout
  title="Dólar a CLP | Conversor USD a Peso Chileno"
  description="Convierte dólares a pesos chilenos con el valor del dólar observado publicado por el Banco Central de Chile."
>
  <Fragment slot="head">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Qué es el dólar observado en Chile?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "El dólar observado es el tipo de cambio oficial del peso chileno respecto al dólar estadounidense, publicado diariamente por el Banco Central de Chile en base a las operaciones del mercado cambiario formal."
            }
          },
          {
            "@type": "Question",
            "name": "¿Cómo convertir dólares a pesos chilenos?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Para convertir USD a CLP se multiplica el monto en dólares por el valor del dólar observado publicado por el Banco Central de Chile."
            }
          },
          {
            "@type": "Question",
            "name": "¿El conversor USD a CLP es exacto?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "El conversor es referencial y se basa en el dólar observado publicado oficialmente por el Banco Central de Chile. No representa el tipo de cambio de bancos o casas de cambio."
            }
          }
        ]
      }
    </script>
  </Fragment>

  <main class="max-w-2xl mx-auto px-4 py-12">
    <h1 id="pageTitle" class="text-3xl font-semibold tracking-tight text-white">
      Dólar a CLP
    </h1>

    <p id="pageDesc" class="mt-2 text-slate-400">
      Conversor rápido de Dólar Estadounidense a Peso Chileno.
    </p>

    <div class="mt-6 p-6 rounded-xl border border-white/10 bg-white/5">
      <!-- Valor actual -->
      <div class="text-sm text-slate-400 mb-4">
        Dólar observado hoy:
        <span class="text-blue-400 font-medium">
          $ {usdValue.toLocaleString("es-CL")}
        </span>
        <span class="text-slate-500">
          - Actualizado al {updatedAt}
        </span>
        <span class="text-slate-600"> · Banco Central de Chile (BCCh) </span>
      </div>

      <!-- Input header -->
      <div class="flex items-center justify-between mb-2">
        <label id="inputLabel" class="block text-sm text-slate-300">
          Ingresa USD
        </label>
        <button
          id="swapBtn"
          type="button"
          class="w-20 h-10 flex items-center justify-center rounded-lg border border-white/10 text-slate-300 hover:text-white hover:bg-white/5 transition text-sm"
          title="Invertir conversión"
        >
          <span
            id="swapIcon"
            class="inline-block transition-transform duration-300">⇄</span
          >
        </button>
      </div>

      <!-- Input -->
      <input
        id="usdInput"
        type="number"
        step="0.01"
        placeholder="Ej: 100 USD"
        class="w-full px-4 py-3 rounded-lg bg-[#070b16] border border-white/10 text-white outline-none focus:border-blue-500"
      />

      <!-- Resultado -->
      <div
        class="mt-6 p-4 rounded-lg border border-white/10 bg-[#070b16] flex items-center justify-between gap-4"
      >
        <div>
          <div class="text-sm text-slate-400">Resultado</div>
          <div id="result" class="text-2xl text-white mt-1">—</div>
        </div>
        <button
          id="copyBtn"
          class="px-3 py-2 rounded-lg border border-white/10 text-slate-300 hover:text-white hover:bg-white/5 transition text-sm"
        >
          Copiar
        </button>
      </div>

      <!-- Variaciones -->
      <div class="mt-4 flex items-center gap-3 text-xs text-slate-400">
        <span>Variaciones USD:</span>
        <span class={var7Class}>7 días {var7Text}</span>
        <span class="text-slate-600">•</span>
        <span class={var30Class}>30 días {var30Text}</span>
        <span class="text-slate-600">•</span>
        <span class={var60Class}>60 días {var60Text}</span>
      </div>
    </div>

    <!-- Conversiones rápidas -->
    <section class="mt-6">
      <h2 class="text-white font-semibold text-base mb-2">
        Conversiones comunes de USD a CLP
      </h2>
      <p class="text-slate-500 text-xs mb-4">
        Valores aproximados según el dólar observado de hoy. Haz clic para usar
        el monto.
      </p>

      <div class="space-y-1">
        {
          [1, 10, 50, 100, 500, 1000].map((value) => (
            <button
              class="quick-row w-full flex items-center justify-between px-10 py-2 rounded-lg bg-white/5 hover:bg-white/10 transition text-sm"
              data-value={value}
              type="button"
            >
              <span class="text-slate-200">
                {value.toLocaleString("es-CL")} USD
              </span>
              <span class="text-slate-400">
                ${" "}
                {(value * usdValue).toLocaleString("es-CL", {
                  minimumFractionDigits: 0,
                  maximumFractionDigits: 0,
                })}
              </span>
            </button>
          ))
        }
      </div>

      <div class="sr-only">
        {
          [1, 10, 50, 100, 500, 1000].map((value) => (
            <p>
              {value} USD equivalen aproximadamente a $
              {(value * usdValue).toLocaleString("es-CL")} pesos chilenos.
            </p>
          ))
        }
      </div>
    </section>

    <!-- Contenido SEO -->
    <section class="mt-6 text-slate-300 leading-relaxed text-sm">
      <h2 class="text-white font-semibold text-lg mb-4">
        ¿Qué es el dólar observado?
      </h2>

      <div class="flex gap-2 mb-4">
        <button
          id="tabShort"
          class="px-3 py-2 rounded-lg border border-white/10 bg-white/10 text-white text-xs font-medium transition"
          type="button"
        >
          En pocas palabras
        </button>

        <button
          id="tabFull"
          class="px-3 py-2 rounded-lg border border-white/10 text-slate-300 text-xs font-medium hover:bg-white/5 transition"
          type="button"
        >
          Explicación completa
        </button>
      </div>

      <!-- Corto -->
      <div id="contentShort">
        <p>
          El dólar observado es el precio oficial del dólar en Chile, calculado
          cada día por el Banco Central en base a las operaciones reales del
          mercado. Es el valor de referencia para contratos, impuestos y
          transacciones en moneda extranjera.
        </p>
      </div>

      <!-- Completo -->
      <div id="contentFull" class="hidden">
        <p>
          El dólar observado es el tipo de cambio del peso chileno (CLP)
          respecto al dólar estadounidense (USD), publicado diariamente por el
          Banco Central de Chile. Se calcula como el promedio ponderado de las
          operaciones del mercado cambiario formal realizadas el día hábil
          anterior.
        </p>

        <p class="mt-3">
          Es el valor utilizado como referencia oficial en Chile para contratos,
          declaraciones de impuestos, importaciones y exportaciones. Difiere del
          dólar que ofrecen los bancos o casas de cambio, que incluyen márgenes
          comerciales.
        </p>
      </div>

      <h2 class="text-white font-semibold text-lg mt-8 mb-2">
        ¿Cómo convertir USD a CLP?
      </h2>
      <p>
        Para convertir dólares a pesos chilenos, se multiplica el monto en USD
        por el valor del dólar observado del día, publicado por el Banco Central
        de Chile. Este conversor lo hace automáticamente.
      </p>

      <div class="sr-only">
        <p>
          Conversor de dólar a pesos chilenos usando el dólar observado del
          Banco Central de Chile.
        </p>
        <p>
          Incluye conversiones rápidas de 1 USD, 10 USD, 50 USD, 100 USD, 500
          USD y 1000 USD a CLP.
        </p>
        <p>
          El cálculo se actualiza automáticamente según el valor diario del
          dólar observado.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline define:vars={{ usdValue }}>
  document.addEventListener("DOMContentLoaded", () => {
    const pageTitle = document.getElementById("pageTitle");
    const pageDesc = document.getElementById("pageDesc");
    const input = document.getElementById("usdInput");
    const result = document.getElementById("result");
    const copyBtn = document.getElementById("copyBtn");
    const swapBtn = document.getElementById("swapBtn");
    const swapIcon = document.getElementById("swapIcon");
    const inputLabel = document.getElementById("inputLabel");
    const tabShort = document.getElementById("tabShort");
    const tabFull = document.getElementById("tabFull");
    const contentShort = document.getElementById("contentShort");
    const contentFull = document.getElementById("contentFull");

    let mode = "USD_TO_CLP";

    function formatCLP(value) {
      return (
        "$" +
        value.toLocaleString("es-CL", {
          minimumFractionDigits: 0,
          maximumFractionDigits: 0,
        })
      );
    }

    function formatUSD(value) {
      return (
        value.toLocaleString("es-CL", {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        }) + " USD"
      );
    }

    function updateUI() {
      if (mode === "USD_TO_CLP") {
        inputLabel.innerText = "Ingresa USD";
        input.placeholder = "Ej: 100 USD";
        pageTitle.innerText = "Dólar a CLP";
        pageDesc.innerText =
          "Conversor rápido de Dólar Estadounidense a Peso Chileno.";
      } else {
        inputLabel.innerText = "Ingresa CLP";
        input.placeholder = "Ej: 50000";
        pageTitle.innerText = "CLP a Dólar";
        pageDesc.innerText =
          "Conversor rápido de Peso Chileno a Dólar Estadounidense.";
      }
    }

    function calc() {
      const raw = input.value.replace(",", ".");
      const amount = Number(raw);
      if (isNaN(amount) || amount <= 0) {
        result.innerText = "—";
        return;
      }

      result.innerText =
        mode === "USD_TO_CLP"
          ? formatCLP(amount * usdValue)
          : formatUSD(amount / usdValue);
    }

    // -----------------------------
    // TABS (explicación UF)
    // -----------------------------
    function activateTab(tab) {
      const isShort = tab === "short";

      contentShort.classList.toggle("hidden", !isShort);
      contentFull.classList.toggle("hidden", isShort);

      tabShort.classList.toggle("bg-white/10", isShort);
      tabShort.classList.toggle("text-white", isShort);
      tabShort.classList.toggle("text-slate-300", !isShort);

      tabFull.classList.toggle("bg-white/10", !isShort);
      tabFull.classList.toggle("text-white", !isShort);
      tabFull.classList.toggle("text-slate-300", isShort);
    }

    tabShort?.addEventListener("click", () => activateTab("short"));
    tabFull?.addEventListener("click", () => activateTab("full"));

    swapBtn?.addEventListener("click", () => {
      swapIcon.style.transform = "rotate(180deg)";
      setTimeout(() => {
        swapIcon.style.transform = "rotate(0deg)";
      }, 300);
      mode = mode === "USD_TO_CLP" ? "CLP_TO_USD" : "USD_TO_CLP";
      updateUI();
      calc();
    });

    input?.addEventListener("input", calc);

    copyBtn?.addEventListener("click", async () => {
      const text = result.innerText;
      if (!text || text === "—") return;
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.innerText = "Copiado ✓";
        setTimeout(() => {
          copyBtn.innerText = "Copiar";
        }, 1200);
      } catch (err) {
        console.error("No se pudo copiar:", err);
      }
    });

    document.addEventListener("click", (e) => {
      const row = e.target.closest(".quick-row");
      if (!row) return;
      const val = row.getAttribute("data-value");
      if (!val) return;
      mode = "USD_TO_CLP";
      updateUI();
      input.value = val;
      calc();
    });

    updateUI();
    activateTab("short");
  });
</script>
