---
import BaseLayout from "../layouts/baselayout.astro";

const updated = new Date().toLocaleDateString("es-CL", {
  timeZone: "America/Santiago",
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
});

const items = [
  {
    n: "01",
    title: "Solo referencial",
    text: "Las herramientas y resultados de LetsGoSimple son informativos. No constituyen asesoría financiera, legal, tributaria, contable ni laboral. Para decisiones importantes, consulta a un profesional.",
  },
  {
    n: "02",
    title: "Los datos pueden variar",
    text: "Valores como UF, USD o UTM provienen de fuentes públicas. Nos esforzamos por mantenerlos actualizados, pero no garantizamos exactitud absoluta ni disponibilidad en todo momento.",
  },
  {
    n: "03",
    title: "Úsalo bajo tu responsabilidad",
    text: "LetsGoSimple no se hace responsable por pérdidas, errores o decisiones tomadas en base a la información del sitio. El uso es tuyo y la responsabilidad también.",
  },
  {
    n: "04",
    title: "Disponibilidad",
    text: "El sitio puede tener interrupciones por mantenimiento o problemas técnicos. No garantizamos disponibilidad continua ni libre de errores.",
  },
  {
    n: "05",
    title: "Propiedad intelectual",
    text: "El diseño, código y contenido original de LetsGoSimple están protegidos por derechos de autor. Puedes usarlo para fines personales, no para copiarlo o redistribuirlo comercialmente.",
  },
  {
    n: "06",
    title: "Enlaces externos",
    text: "Si enlazamos a sitios externos, no controlamos su contenido ni sus políticas. Visítalos bajo tu criterio.",
  },
  {
    n: "07",
    title: "Jurisdicción",
    text: "Este sitio opera desde Chile. Cualquier disputa se rige por la legislación chilena vigente.",
  },
  {
    n: "08",
    title: "Cambios",
    text: "Podemos actualizar estos términos cuando sea necesario. La fecha arriba siempre reflejará la versión vigente. Seguir usando el sitio implica aceptarlos.",
  },
];
---

<BaseLayout
  title="Términos | LetsGoSimple"
  description="Términos y condiciones de uso de LetsGoSimple."
>
  <main class="max-w-3xl mx-auto px-6 py-20">
    <!-- Header -->
    <div class="mb-14">
      <p class="text-xs uppercase tracking-widest text-slate-500 mb-4">Legal</p>
      <h1 class="text-4xl font-bold text-slate-50 tracking-tight">Términos</h1>
      <p class="mt-3 text-slate-400">
        Al usar el sitio, aceptas esto. Es corto, léelo.
      </p>
      <p class="mt-2 text-xs text-slate-600">Actualizado: {updated}</p>
    </div>

    <!-- Items -->
    <div class="space-y-8">
      {
        items.map((item) => (
          <div class="flex gap-6">
            <span class="text-xs font-mono text-slate-700 pt-1 shrink-0 w-6">
              {item.n}
            </span>
            <div class="border-t border-slate-800 pt-4 flex-1">
              <h2 class="text-sm font-semibold text-slate-200 mb-2">
                {item.title}
              </h2>
              <p class="text-sm text-slate-500 leading-relaxed">{item.text}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Contact -->
    <div class="mt-16 border-t border-slate-800 pt-10">
      <p class="text-sm text-slate-500">
        ¿Dudas? Escríbenos a{" "}
        <a
          href="mailto:contacto@letsgosimple.app"
          class="text-slate-300 hover:text-white underline underline-offset-4 transition-colors"
        >
          contacto@letsgosimple.app
        </a>
      </p>
    </div>

    <!-- Back -->
    <div class="mt-10">
      <a
        href="/"
        class="text-xs text-slate-600 hover:text-slate-400 transition-colors"
        >← Volver al inicio</a
      >
    </div>
  </main>
</BaseLayout>
